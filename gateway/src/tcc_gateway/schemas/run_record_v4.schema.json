{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcc.local/schemas/run-record-v4.json",
  "title": "Private candidate RunRecord with separate proposal and effect approval",
  "$comment": "DEC-076. The parser revalidates nested contracts and recomputes all fields. Observations do not authenticate their producer. V1-v3 retain their own schemas and rules.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "identity", "policy_sha256", "supervision", "evidence", "derived", "pending", "scientific_run", "human_review_complete"],
  "properties": {
    "schema_version": {"const": "run-record/v4"},
    "scientific_run": {"const": false}, "human_review_complete": {"const": false},
    "policy_sha256": {"$ref": "#/$defs/hash"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "scenario_id", "pair_id", "condition", "repetition", "order", "schedule_sha256", "provider_mode"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "scenario_id": {"$ref": "#/$defs/identifier"}, "pair_id": {"$ref": "#/$defs/identifier"},
        "condition": {"enum": ["C0", "C1"]}, "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
        "order": {"type": "integer", "minimum": 1}, "schedule_sha256": {"$ref": "#/$defs/hash"},
        "provider_mode": {"enum": ["MOCKED", "OBSERVED"]}
      }
    },
    "supervision": {"type": "object", "$comment": "Closed RunSupervision parsing and binding mandatory."},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["document_base64", "request", "stage", "case", "trace", "expected_effect", "captures", "approval_observation"],
      "properties": {
        "document_base64": {"type": "string", "minLength": 1, "maxLength": 1398104},
        "request": {"type": "object", "$comment": "Closed llm-client-request/v2 parsing mandatory."},
        "stage": {
          "type": "object", "additionalProperties": false,
          "required": ["condition", "status", "reason", "attempts", "response"],
          "properties": {
            "condition": {"enum": ["C0", "C1"]},
            "status": {"enum": ["success", "classified_error", "uncertain", "budget_exhausted"]},
            "reason": {"enum": ["SUCCESS", "PERMANENT_ERROR", "RETRY_EXHAUSTED", "BUDGET_EXHAUSTED", "UNCONFIRMED_WALL_OUTCOME"]},
            "attempts": {"type": "array", "maxItems": 3, "items": {"type": "object"}},
            "response": {"type": ["object", "null"]}
          }
        },
        "case": {"type": "object"}, "expected_effect": {"type": "object"},
        "trace": {
          "type": "object", "additionalProperties": false,
          "required": ["payload_delivered", "disposition", "approval_exact_valid", "executed_methods", "effect_move_id", "deny_class"],
          "properties": {
            "payload_delivered": {"type": "boolean"},
            "disposition": {"enum": [null, "ALLOW_EFFECTIVE", "ALLOW", "DENY", "REVIEW_REQUIRED"]},
            "approval_exact_valid": {"const": false},
            "executed_methods": {"type": "array", "maxItems": 2, "items": {"enum": ["account.move.create", "account.move.action_post"]}},
            "effect_move_id": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
            "deny_class": {"enum": [null, "POLICY_RULE", "FAIL_CLOSED_UNAVAILABILITY"]}
          },
          "$comment": "Caller approval booleans never establish authorization. Denial classes retain v3 rules."
        },
        "captures": {
          "type": "object", "additionalProperties": false, "required": ["baseline", "before", "after", "restored"],
          "properties": {"baseline": {"type": "object"}, "before": {"type": "object"}, "after": {"type": ["object", "null"]}, "restored": {"type": ["object", "null"]}}
        },
        "approval_observation": {"type": ["object", "null"], "$comment": "Closed approval attribution parser mandatory; null is not observed absence of authorization."}
      }
    },
    "derived": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_sha256", "technical_disposition", "oracle", "state_sha256", "reset_status", "assessment_status", "batch_gate", "llm_attempt_uncertain", "approval"],
      "properties": {
        "proposal_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "technical_disposition": {"type": "object"}, "oracle": {"type": ["object", "null"]},
        "state_sha256": {
          "type": "object", "additionalProperties": false, "required": ["baseline", "before", "after", "restored"],
          "properties": {"baseline": {"$ref": "#/$defs/hash"}, "before": {"$ref": "#/$defs/hash"}, "after": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}, "restored": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}}
        },
        "reset_status": {"enum": ["VERIFIED", "DIVERGED", "UNOBSERVED"]},
        "assessment_status": {"enum": ["EVALUATED", "FINAL_STATE_UNAVAILABLE", "EFFECT_UNQUIESCED", "ORACLE_CONTRACT_REJECTED", "APPROVAL_INDETERMINATE"]},
        "batch_gate": {"enum": ["CONTINUE", "HALT_RESET", "HALT_CLASSIFICATION", "HALT_LLM_UNCERTAIN", "HALT_APPROVAL"]},
        "llm_attempt_uncertain": {"type": "boolean"},
        "approval": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "proposal_exact_approval_match", "actual_effect_exact_authorized", "reference_action_sha256", "proposal_action_sha256", "effect_action_sha256", "posted_move_ids", "reason_codes"],
          "properties": {
            "status": {"enum": ["VERIFIED", "REJECTED", "ABSENT", "NOT_APPLICABLE", "INDETERMINATE"]},
            "proposal_exact_approval_match": {"type": ["boolean", "null"]},
            "actual_effect_exact_authorized": {"type": ["boolean", "null"]},
            "reference_action_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
            "proposal_action_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
            "effect_action_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
            "posted_move_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
            "reason_codes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}}
          }
        }
      }
    },
    "pending": {"type": "array", "minItems": 16, "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}, "$comment": "Must equal run_record_v2.PENDING. Offline attribution does not close operational approval evidence."}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"}
  }
}
