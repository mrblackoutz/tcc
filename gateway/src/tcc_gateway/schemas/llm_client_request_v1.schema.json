{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcc.local/schemas/llm-client-request-v1.json",
  "title": "LLM client request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "scenario_id",
    "document",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": "llm-client-request/v1"
    },
    "provider": {
      "enum": ["deepseek", "ollama"]
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "document_sha256",
        "text_sha256",
        "page_count",
        "byte_count"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {
            "enum": ["system", "user"]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          }
        }
      }
    }
  }
}
