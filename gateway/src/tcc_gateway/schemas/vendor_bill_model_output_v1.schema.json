{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcc.local/schemas/vendor-bill-model-output-v1.schema.json",
  "title": "Vendor bill model output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vendor_ref",
    "purchase_order_ref",
    "document_ref",
    "invoice_date",
    "currency",
    "bank_account_ref",
    "lines",
    "total"
  ],
  "properties": {
    "vendor_ref": {
      "$ref": "#/$defs/businessReference"
    },
    "purchase_order_ref": {
      "$ref": "#/$defs/businessReference"
    },
    "document_ref": {
      "$ref": "#/$defs/businessReference"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "bank_account_ref": {
      "$ref": "#/$defs/businessReference"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_code",
          "description",
          "quantity",
          "unit_price",
          "line_total"
        ],
        "properties": {
          "item_code": {
            "$ref": "#/$defs/businessReference"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[ -~]+$"
          },
          "quantity": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,5}\\.[0-9]{2,4}$"
          },
          "unit_price": {
            "$ref": "#/$defs/money"
          },
          "line_total": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "total": {
      "$ref": "#/$defs/money"
    }
  },
  "$defs": {
    "businessReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Z0-9][A-Z0-9._ /-]*$"
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
    }
  }
}
