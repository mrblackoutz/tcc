{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcc.local/schemas/run-record-v1.json",
  "title": "Private candidate RunRecord envelope",
  "$comment": "Structural envelope only. parse_run_record MUST also revalidate the nested v2 request/response, attempts, complete company captures and oracle, and recompute derived values. JSON Schema alone is NOT acceptance or scientific completeness.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "identity", "policy_sha256", "supervision", "evidence", "derived", "pending", "scientific_run", "human_review_complete"],
  "properties": {
    "schema_version": {"const": "run-record/v1"},
    "scientific_run": {"const": false},
    "human_review_complete": {"const": false},
    "policy_sha256": {"$ref": "#/$defs/hash"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "scenario_id", "pair_id", "condition", "repetition", "order", "schedule_sha256", "provider_mode"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "scenario_id": {"$ref": "#/$defs/identifier"}, "pair_id": {"$ref": "#/$defs/identifier"},
        "condition": {"enum": ["C0", "C1"]},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
        "order": {"type": "integer", "minimum": 1},
        "schedule_sha256": {"$ref": "#/$defs/hash"}, "provider_mode": {"enum": ["MOCKED", "OBSERVED"]}
      }
    },
    "supervision": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "condition", "code_commit", "configuration_sha256", "host_id", "clock_id", "mode", "effect_quiescence", "intervals"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "condition": {"enum": ["C0", "C1"]},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "configuration_sha256": {"$ref": "#/$defs/hash"},
        "host_id": {"$ref": "#/$defs/identifier"}, "clock_id": {"$ref": "#/$defs/identifier"},
        "mode": {"enum": ["MOCKED", "OBSERVED"]}, "effect_quiescence": {"const": "CONFIRMED"},
        "intervals": {"type": "array", "minItems": 1, "maxItems": 6, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "started_ns", "ended_ns"],
          "properties": {
            "name": {"enum": ["llm", "observation", "policy", "execution", "capture", "reset"]},
            "started_ns": {"type": "integer", "minimum": 0}, "ended_ns": {"type": "integer", "minimum": 0}
          }
        }}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["document_base64", "request", "stage", "case", "trace", "expected_effect", "captures"],
      "properties": {
        "document_base64": {"type": "string", "minLength": 1, "maxLength": 1398104},
        "request": {"type": "object", "$comment": "Closed llm-client-request/v2 parser is mandatory."},
        "stage": {
          "type": "object", "additionalProperties": false,
          "required": ["condition", "status", "reason", "attempts", "response"],
          "properties": {
            "condition": {"enum": ["C0", "C1"]}, "status": {"const": "success"}, "reason": {"const": "SUCCESS"},
            "attempts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object"}},
            "response": {"type": "object", "$comment": "Closed response and proposal parsers plus request/attempt binding are mandatory."}
          }
        },
        "case": {"type": "object", "$comment": "OracleCase parser is mandatory; trusted evaluation input only."},
        "trace": {
          "type": "object", "additionalProperties": false,
          "required": ["payload_delivered", "disposition", "approval_exact_valid", "executed_methods", "effect_move_id"],
          "properties": {
            "payload_delivered": {"type": "boolean"},
            "disposition": {"enum": [null, "ALLOW_EFFECTIVE", "ALLOW", "DENY", "REVIEW_REQUIRED"]},
            "approval_exact_valid": {"const": false},
            "executed_methods": {"type": "array", "maxItems": 2, "items": {"enum": ["account.move.create", "account.move.action_post"]}},
            "effect_move_id": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}
          }
        },
        "expected_effect": {"type": "object", "$comment": "ExpectedEffect parser is mandatory; independent fixture truth."},
        "captures": {
          "type": "object", "additionalProperties": false, "required": ["baseline", "before", "after", "restored"],
          "properties": {"baseline": {"type": "object"}, "before": {"type": "object"}, "after": {"type": "object"}, "restored": {"type": "object"}},
          "$comment": "All four company-capture/v1 envelopes must pass the complete capture parser and common binding/reset checks."
        }
      }
    },
    "derived": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_sha256", "technical_disposition", "oracle", "state_sha256"],
      "properties": {
        "proposal_sha256": {"$ref": "#/$defs/hash"},
        "technical_disposition": {"type": "object"}, "oracle": {"type": "object"},
        "state_sha256": {
          "type": "object", "additionalProperties": false, "required": ["baseline", "before", "after", "restored"],
          "properties": {"baseline": {"$ref": "#/$defs/hash"}, "before": {"$ref": "#/$defs/hash"}, "after": {"$ref": "#/$defs/hash"}, "restored": {"$ref": "#/$defs/hash"}}
        }
      },
      "$comment": "Every derived value must match recomputation byte-for-byte; a supplied score is never authority."
    },
    "pending": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}, "$comment": "Must equal run_record.PENDING in the authoritative parser; never remove to claim completeness."}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"}
  }
}
