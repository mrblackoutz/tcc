<odoo>
    <record id="group_executor" model="res.groups">
        <field name="name">TCC: restricted accounts payable executor</field>
        <field name="comment">Preflight only. No accounting, purchase, bank or payment authority.</field>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
    </record>
    <record id="access_executor_read" model="ir.model.access">
        <field name="name">TCC executor service: read only</field>
        <field name="model_id" ref="model_ap_security_executor"/>
        <field name="group_id" ref="group_executor"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
