# Referência local exclusivamente sintética. Prefira gerar `.env` e
# `.runtime/odoo.conf` com `scripts/new_local_env.ps1`; nunca versione `.env`.
POSTGRES_DB=tcc_ap_lab
POSTGRES_USER=tcc_ap_lab
POSTGRES_PASSWORD=synthetic-local-only-change-me

# Usada somente pelo bootstrap para gerar `.runtime/odoo.conf` local.
# O valor não é passado na linha de comando do processo Odoo.
ODOO_ADMIN_PASSWORD=synthetic-local-only-change-me

# A publicação permanece restrita ao loopback pelo Compose.
ODOO_HTTP_PORT=8069

# Parâmetros não sensíveis consumidos pelo gateway JSON-2. A chave real é
# lida do arquivo local ignorado, nunca deste arquivo de exemplo.
ODOO_BASE_URL=http://127.0.0.1:8069
ODOO_DATABASE=tcc_ap_lab
ODOO_API_TOKEN_FILE=.runtime/secrets/odoo_api_key

# G3a/G3b/G3c: somente nomes e valores de configuração não sensíveis. A chave
# DeepSeek existe apenas no arquivo local ignorado. O perfil G3b continua mock;
# o script G3c monta somente esse arquivo read-only após autorização explícita.
DEEPSEEK_API_KEY_FILE=.runtime/secrets/deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_OUTPUT_TOKENS=2048

# Endpoint local permitido para desenvolvimento host-side. O serviço Ollama
# permanece fora das runs até download autorizado e lock completo do Qwen3.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b-q4_K_M
OLLAMA_TEMPERATURE=0
OLLAMA_MAX_OUTPUT_TOKENS=2048

# O valor padrão permanece mock. O serviço separado e profile-gated de G3c
# sobrescreve o modo sem alterar nem abrir o serviço offline de G3b.
TCC_LLM_CLIENT_MODE=mock
TCC_LLM_CLIENT_PORT=8080
TCC_EGRESS_PROXY_PORT=8888
