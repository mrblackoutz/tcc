# Configuração local exclusivamente sintética. Copie para `.env` e substitua
# as senhas antes de subir o laboratório. `.env` nunca deve ser versionado.
POSTGRES_DB=tcc_ap_lab
POSTGRES_USER=tcc_lab_synthetic
POSTGRES_PASSWORD=synthetic-local-only-change-me

# Usada somente pelo bootstrap para gerar `.runtime/odoo.conf` local.
# O valor não é passado na linha de comando do processo Odoo.
ODOO_ADMIN_PASSWORD=synthetic-local-only-change-me

# A publicação permanece restrita ao loopback pelo Compose.
ODOO_HTTP_PORT=8069

# Parâmetros não sensíveis consumidos pelo gateway JSON-2. A chave real é
# lida do arquivo local ignorado, nunca deste arquivo de exemplo.
ODOO_BASE_URL=http://127.0.0.1:8069
ODOO_DATABASE=tcc_ap_lab
ODOO_API_TOKEN_FILE=.runtime/secrets/odoo_api_key
